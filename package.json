{
  "name": "cadets-assessment-system",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "esbuild src/tests/comprehensive_test.ts --bundle --platform=node --format=esm --outfile=dist/test_bundle.mjs && node dist/test_bundle.mjs",
    "audit": "esbuild src/tests/complete_system_audit.ts --bundle --platform=node --format=esm --outfile=dist/audit_bundle.mjs && node dist/audit_bundle.mjs",
    "test:all": "npm test && npm run audit"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lenis": "^1.3.26",
    "lucide-react": "^1.37.0",
    "motion": "^13.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "puppeteer-core": "^25.9.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
