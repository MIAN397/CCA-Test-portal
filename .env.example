# ==============================================================================
# Cadets Coaching Academy Assessment Portal (CCAP) - Environment Configuration
# ==============================================================================

# Google Identity Services (OAuth 2.0) Client ID
# 1. Create a Project in Google Cloud Console: https://console.cloud.google.com/
# 2. Go to APIs & Services > Credentials > Create Credentials > OAuth client ID
# 3. Application Type: Web application
# 4. Authorized JavaScript origins:
#    - http://localhost:5173
#    - https://your-production-domain.com
# 5. Copy the Client ID and paste below:
VITE_GOOGLE_CLIENT_ID=

# ==============================================================================
# Firebase & Cloud Firestore Configuration (Project: ccap-testportal)
# ==============================================================================
# Find these in Firebase Console: Project Settings > General > Your apps (Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=ccap-testportal.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ccap-testportal
VITE_FIREBASE_STORAGE_BUCKET=ccap-testportal.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ==============================================================================
# Safepay Payment Gateway Configuration (Easypaisa, JazzCash, Cards)
# ==============================================================================
VITE_SAFEPAY_API_KEY=sec_27f4ce18-08ef-4a73-9cd3-a8cf7ca954e8
VITE_SAFEPAY_ENV=sandbox

# ==============================================================================
# Transactional Email Service (For Live Password Reset OTP Email Delivery)
# ==============================================================================
# OPTION 1 (RECOMMENDED): Google Apps Script Web App Gateway
# 100% Free, sends directly from your academy Gmail to any personal email, no CORS issues.
# Deploy a simple Google Apps Script as Web App and paste the URL below:
VITE_EMAIL_GATEWAY_URL=

# OPTION 2: EmailJS (Browser-Native Client Email Service)
# Free 200 emails/month, connects directly to your Gmail account.
# Sign up at https://www.emailjs.com/
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# OPTION 3: Resend API Key
# Sign up at https://resend.com
VITE_RESEND_API_KEY=
VITE_EMAIL_FROM="Cadets Coaching Academy <onboarding@resend.dev>"

# OPTION 4: Brevo API Key
# Sign up at https://brevo.com
VITE_BREVO_API_KEY=



# Production MongoDB + Render Backend API URL
VITE_API_URL=https://cca-test-portal.onrender.com
