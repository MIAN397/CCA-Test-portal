rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Institutional Profiles & Credentials
    // Allows real-time cross-device profile synchronization while preventing accidental or malicious document purges
    match /profiles/{profileId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // 2. Google Authentication Profiles
    match /users/{userId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // 3. Cadet Assessment Submissions
    // Submissions can be read and recorded, but never deleted from the cloud ledger
    match /submissions/{submissionId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // 4. Academy Membership Subscriptions
    match /subscriptions/{subscriptionId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // 5. Cadet Quizzes & Examinations Bank
    match /quizzes/{quizId} {
      allow read, write: if true;
    }

    // 6. Global Academy Master Sync State & Realtime Backups
    match /app_data/{docId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // Default deny for all other documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
